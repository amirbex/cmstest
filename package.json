{
  "name": "atoz-cms",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "AtoZ.FnB Content Studio v7 — plan-driven content operations: ideas → assets → scheduled publishes, with an editor, a subtitle pipeline and a motion-recipe catalogue",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "app/server",
    "app/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm --workspace app/web run dev",
    "dev:api": "npm --workspace app/server run dev",
    "build": "npm --workspace app/web run build",
    "start": "NODE_ENV=production node --experimental-sqlite app/server/src/main.js",
    "test": "node --experimental-sqlite --test tests/*.test.js",
    "typecheck": "npm --workspace app/web run typecheck",
    "setup": "node scripts/setup.js",
    "seed": "node --experimental-sqlite scripts/seed.js",
    "setup:ai": "node scripts/setup-ai.js",
    "verify:ai": "node --experimental-sqlite scripts/verify-ai.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^3.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5"
  }
}
