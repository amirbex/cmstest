# ────────────────────────── AtoZ Content Studio v6 ──────────────────────────
# همه‌ی متغیرها اختیاری‌اند. نبودشان برنامه را متوقف نمی‌کند؛
# فقط سطح کیفیت را پایین می‌آورد. این فایل را به .env کپی کن.

# ── سرور ──
PORT=4000
HOST=0.0.0.0
# NODE_ENV=production
# ATOZ_DEBUG=1              # نمایش متن خطای داخلی در پاسخ HTTP (فقط توسعه)

# ── محل داده ──
# ATOZ_DATA_DIR=storage/data
# ATOZ_OUTPUT_DIR=storage/outputs

# ── موتور گرافیک ──
# ATOZ_FFMPEG=/usr/bin/ffmpeg   # به‌طور پیش‌فرض باینری همراه پکیج استفاده می‌شود

# ────────────────────────── مدل‌های هوش مصنوعی ──────────────────────────
# Gemini مسیر اصلی است. مدل محلی فقط یک گزینه/پشتیبان است، نه اصل کار.
#
# ۱) Gemini — توصیه‌شده. بهترین کار:  npm run setup:ai
#    (کلید را می‌گیرد، مدل‌ها را کشف می‌کند، با یک فراخوانی واقعی آزمایش می‌کند
#     و زنجیره مدل را خودش در .env می‌نویسد)
GEMINI_API_KEY=
# اگر دستی تنظیم می‌کنی: فقط مدل‌های زنده. خانواده gemini-2.5 در
# ۲۰۲۶-۱۰-۱۶ بازنشسته شد و هر فراخوانی به آن ۴۰۴ می‌دهد.
ATOZ_MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# ATOZ_MAX_OUTPUT_TOKENS=8192

# ۲) مدل محلی — اختیاری. هر سرور سازگار با OpenAI.
#    فقط وقتی استفاده می‌شود که کلید Gemini نباشد یا Gemini خطا بدهد.
#    Ollama:     ollama pull qwen2.5:7b-instruct  &&  ollama serve
#    LM Studio:  http://localhost:1234/v1
#    llama.cpp:  http://localhost:8080/v1
# ATOZ_LOCAL_AI_URL=http://localhost:11434/v1
# ATOZ_LOCAL_AI_MODEL=qwen2.5:7b-instruct
# ATOZ_LOCAL_AI_TIMEOUT_MS=120000
# ATOZ_LOCAL_AI_FALLBACK=1     # 0 = مدل محلی هرگز به جای Gemini اجرا نشود

# ۳) قالب آفلاین — هیچ تنظیمی لازم نیست (آخرین پشتیبان، همیشه کار می‌کند)

# ────────────────────────── صدا (TTS) ──────────────────────────
# زنجیره: Piper → pyttsx3 → edge-tts → بی‌صدا با زیرنویس زمان‌بندی‌شده
# ATOZ_PIPER=bin/piper
# ATOZ_PIPER_MODEL=bin/fa_IR-amir-medium.onnx
# ATOZ_PYTHON=python3

# ── رفتار ──
# ATOZ_SEED_DEMO=1          # بارگذاری دسته نمونه هنگام بالا آمدن
